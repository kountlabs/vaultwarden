+import { inject } from "@angular/core";
+import { firstValueFrom, lastValueFrom } from "rxjs";
+
+import { CollectionAdminService } from "@bitwarden/admin-console/common";
+import { CollectionView } from "@bitwarden/common/admin-console/models/collections";
+import { Organization } from "@bitwarden/common/admin-console/models/domain/organization";
+import { AccountService } from "@bitwarden/common/auth/abstractions/account.service";
+import { getUserId } from "@bitwarden/common/auth/services/account.service";
+import { LogService } from "@bitwarden/common/platform/abstractions/log.service";
+import { OrganizationId } from "@bitwarden/common/types/guid";
+import { DialogService, ToastService } from "@bitwarden/components";
+
+import {
+  CollectionDialogAction,
+  openCollectionDialog,
+} from "../../shared/components/collection-dialog";
+
+/**
+ * Kount: what the admin console gives the cipher form as `newCollection`. Call it in an injection context; the function
+ * it returns opens the collection dialog and resolves with the collection saved, or undefined when none was.
+ */
+export function kountNewCollectionEntry() {
+  const dialogService = inject(DialogService);
+  const collectionAdminService = inject(CollectionAdminService);
+  const accountService = inject(AccountService);
+  const toastService = inject(ToastService);
+  const logService = inject(LogService);
+
+  return async (organization: Organization, itemName: string) => {
+    const dialog = openCollectionDialog(dialogService, {
+      data: {
+        organizationId: organization.id as OrganizationId,
+        limitNestedCollections: !organization.canEditAnyCollection,
+        isAdminConsoleActive: true,
+        initialName: itemName,
+      },
+    });
+    const result = await lastValueFrom(dialog.closed);
+    if (result?.action !== CollectionDialogAction.Saved || !result.collection?.id) {
+      return undefined;
+    }
+
+    // The result's name is ciphertext; the view read back by id carries the name the form shows.
+    let saved: CollectionView | undefined;
+    try {
+      const userId = await firstValueFrom(accountService.activeAccount$.pipe(getUserId));
+      const views = await firstValueFrom(
+        collectionAdminService.collectionAdminViews$(organization.id, userId),
+      );
+      saved = views.find((view) => view.id === result.collection.id);
+    } catch (e) {
+      logService.error(e);
+    }
+    if (saved == null) {
+      toastService.showToast({
+        variant: "error",
+        message:
+          "The collection was saved, but could not be selected here. Close this dialog and add the item again.",
+      });
+    }
+    return saved;
+  };
+}
