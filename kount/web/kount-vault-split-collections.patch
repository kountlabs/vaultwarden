+++ b/apps/web/src/app/admin-console/organizations/collections/kount/split-stamp.ts
@@ -0,0 +1,85 @@
+import { CipherView } from "@bitwarden/common/vault/models/view/cipher.view";
+
+/**
+ * Kount: the stamp a split collection carries as its External ID, `kp:new:<host>|<name>|<username>` (plan claim-and-sso D1;
+ * apps/vaultwarden-kount/conformance/stamp-vectors.json `encode` is the contract the browser proofs compare with).
+ */
+const STAMP_BUDGET = 300;
+
+export type LoginFacts = { host: string; name: string; username: string };
+
+export type SplitPattern = "item" | "item-username" | "website-username" | "prefix-item";
+
+const encodeField = (value: string) => value.replace(/%/g, "%25").replace(/\|/g, "%7C");
+
+/**
+ * The stamp, or null when it cannot be written: the host and username alone are over the budget. (Nothing at all to
+ * write is null too, which a saved login cannot reach: its name is required.) Only the name is ever cut, walking whole
+ * code points of the raw name forward, so neither a surrogate pair nor an escape is split and a long name costs its length.
+ */
+export function encodeStamp(login: LoginFacts): string | null {
+  const host = encodeField(login.host);
+  const username = encodeField(login.username);
+  if (`kp:new:${host}||${username}`.length > STAMP_BUDGET) {
+    return null;
+  }
+  // What the name may take: the rest of the budget beside the host and, when there is one, the username.
+  const room = STAMP_BUDGET - `kp:new:${host}|${username && `|${username}`}`.length;
+  let name = "";
+  for (const codePoint of login.name) {
+    const encoded = encodeField(codePoint);
+    if (name.length + encoded.length > room) {
+      break;
+    }
+    name += encoded;
+  }
+  const fields = [host, name, username];
+  while (fields.length > 1 && fields[fields.length - 1] === "") {
+    fields.pop();
+  }
+  const stamp = `kp:new:${fields.join("|")}`;
+  return stamp === "kp:new:" ? null : stamp;
+}
+
+/** The lower-cased hostname of a login's first URI; empty when it has none, or it is not a web address. */
+function hostOf(uri: string | null | undefined): string {
+  const text = uri?.trim();
+  if (!text) {
+    return "";
+  }
+  try {
+    const url = new URL(/^[a-z][a-z0-9+.-]*:\/\//i.test(text) ? text : `https://${text}`);
+    return url.protocol === "https:" || url.protocol === "http:" ? url.hostname.toLowerCase() : "";
+  } catch {
+    return "";
+  }
+}
+
+export function loginFacts(login: CipherView, includeUsername = true): LoginFacts {
+  return {
+    host: hostOf(login.login?.uri),
+    name: login.name ?? "",
+    username: includeUsername ? (login.login?.username ?? "") : "",
+  };
+}
+
+/** The collection's name. A "/" would nest it under a parent that does not exist, so it reads "-" here. */
+export function collectionName(login: LoginFacts, pattern: SplitPattern, prefix: string): string {
+  const both = (first: string, second: string) =>
+    first && second ? `${first} — ${second}` : first || second;
+  let name: string;
+  switch (pattern) {
+    case "item-username":
+      name = both(login.name, login.username);
+      break;
+    case "website-username":
+      name = both(login.host, login.username) || login.name;
+      break;
+    case "prefix-item":
+      name = `${prefix}${login.name}`;
+      break;
+    default:
+      name = login.name;
+  }
+  return name.replace(/\//g, "-");
+}
