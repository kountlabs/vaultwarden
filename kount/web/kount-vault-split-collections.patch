+import { Component, inject, signal } from "@angular/core";
+import { FormBuilder } from "@angular/forms";
+import { lastValueFrom } from "rxjs";
+
+import { Organization } from "@bitwarden/common/admin-console/models/domain/organization";
+import { OrganizationId } from "@bitwarden/common/types/guid";
+import { CipherType } from "@bitwarden/common/vault/enums";
+import { CipherRepromptType } from "@bitwarden/common/vault/enums/cipher-reprompt-type";
+import { CipherView } from "@bitwarden/common/vault/models/view/cipher.view";
+import {
+  DIALOG_DATA,
+  DialogRef,
+  DialogService,
+  ToastService,
+} from "@bitwarden/components";
+import { PasswordRepromptService } from "@bitwarden/vault";
+
+import { SharedModule } from "../../../../shared";
+
+import { SplitCollectionsService, SplitSummary } from "./split-collections.service";
+import { collectionName, encodeStamp, loginFacts, SplitPattern } from "./split-stamp";
+
+const PREVIEW_ROWS = 3;
+// A stop's toast is the only record of what to check, and it can be long: it stays until read.
+const STOP_TOAST_MS = 60000;
+
+interface SplitCollectionsDialogParams {
+  organizationId: OrganizationId;
+  logins: CipherView[];
+  skipped: number;
+}
+
+/** Kount: the confirm dialog of "One collection per item" (plan claim-and-sso item 2 (a)). */
+@Component({
+  templateUrl: "split-collections-dialog.component.html",
+  imports: [SharedModule],
+  providers: [SplitCollectionsService],
+})
+export class SplitCollectionsDialogComponent {
+  private readonly params = inject<SplitCollectionsDialogParams>(DIALOG_DATA);
+  private readonly dialogRef = inject<DialogRef<boolean>>(DialogRef);
+  private readonly splitCollections = inject(SplitCollectionsService);
+  private readonly passwordRepromptService = inject(PasswordRepromptService);
+  private readonly toastService = inject(ToastService);
+
+  protected readonly logins = this.params.logins;
+  protected readonly skipped = this.params.skipped;
+  protected readonly first = this.logins[0];
+  protected readonly running = signal(false);
+  protected readonly done = signal(0);
+
+  protected readonly formGroup = inject(FormBuilder).group({
+    pattern: ["item" as SplitPattern],
+    prefix: [""],
+    includeUsername: [true],
+  });
+
+  protected exampleName(pattern: SplitPattern): string {
+    return collectionName(loginFacts(this.first), pattern, this.prefix);
+  }
+
+  protected get preview(): { collection: string; stamp: string | null }[] {
+    return this.logins.slice(0, PREVIEW_ROWS).map((login) => ({
+      collection: collectionName(loginFacts(login), this.pattern, this.prefix),
+      stamp: encodeStamp(loginFacts(login, this.includeUsername)),
+    }));
+  }
+
+  private get pattern(): SplitPattern {
+    return this.formGroup.controls.pattern.value ?? "item";
+  }
+
+  private get prefix(): string {
+    return this.formGroup.controls.prefix.value ?? "";
+  }
+
+  private get includeUsername(): boolean {
+    return this.formGroup.controls.includeUsername.value ?? true;
+  }
+
+  protected submit = async () => {
+    const protectedItem = this.logins.some((login) => login.reprompt !== CipherRepromptType.None);
+    if (protectedItem && !(await this.passwordRepromptService.showPasswordPrompt())) {
+      return;
+    }
+    this.running.set(true);
+    const summary = await this.splitCollections.run(
+      this.params.organizationId,
+      this.logins,
+      { pattern: this.pattern, prefix: this.prefix, includeUsername: this.includeUsername },
+      (done) => this.done.set(done),
+    );
+    this.showSummary(summary);
+    await this.dialogRef.close(true);
+  };
+
+  private showSummary({ done, total, stop }: SplitSummary): void {
+    if (stop == null) {
+      this.toastService.showToast({
+        variant: "success",
+        message: `${done} of ${total} ${total === 1 ? "login" : "logins"} split, each into its own collection.`,
+      });
+      return;
+    }
+    this.toastService.showToast({
+      variant: "error",
+      timeout: STOP_TOAST_MS,
+      message: `${done} of ${total} ${total === 1 ? "login" : "logins"} split, then it stopped at “${stop.login}”. ${stop.reason} The logins after it were not touched.`,
+    });
+  }
+}
+
+/**
+ * Kount: opens the dialog for what the batch bar selected. Resolves true when a run happened, so the vault reloads.
+ */
+export async function openSplitCollections(
+  dialogService: DialogService,
+  toastService: ToastService,
+  organization: Organization,
+  items: CipherView[],
+): Promise<boolean> {
+  if (!organization.canCreateNewCollections || !organization.canEditAllCiphers) {
+    toastService.showToast({
+      variant: "error",
+      message: "You lack the necessary permissions to perform this action.",
+    });
+    return false;
+  }
+  const logins = items.filter((item) => item.type === CipherType.Login && !item.isDeleted);
+  if (logins.length === 0) {
+    toastService.showToast({ variant: "error", message: "Select at least one login." });
+    return false;
+  }
+  const dialog = dialogService.open<boolean, SplitCollectionsDialogParams>(
+    SplitCollectionsDialogComponent,
+    {
+      data: {
+        organizationId: organization.id as OrganizationId,
+        logins,
+        skipped: items.length - logins.length,
+      },
+      disableClose: true,
+    },
+  );
+  return (await lastValueFrom(dialog.closed)) === true;
+}
