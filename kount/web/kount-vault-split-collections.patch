@@ -0,0 +1,155 @@
+import { inject, Injectable } from "@angular/core";
+import { firstValueFrom } from "rxjs";
+
+import { CollectionAdminService } from "@bitwarden/admin-console/common";
+import { ApiService } from "@bitwarden/common/abstractions/api.service";
+import { CollectionAdminView } from "@bitwarden/common/admin-console/models/collections";
+import { AccountService } from "@bitwarden/common/auth/abstractions/account.service";
+import { getUserId } from "@bitwarden/common/auth/services/account.service";
+import { ErrorResponse } from "@bitwarden/common/models/response/error.response";
+import { Utils } from "@bitwarden/common/platform/misc/utils";
+import { CollectionId, OrganizationId, UserId } from "@bitwarden/common/types/guid";
+import { CipherView } from "@bitwarden/common/vault/models/view/cipher.view";
+
+import { collectionName, encodeStamp, loginFacts, SplitPattern } from "./split-stamp";
+
+export interface SplitOptions {
+  pattern: SplitPattern;
+  prefix: string;
+  includeUsername: boolean;
+}
+
+export interface SplitSummary {
+  done: number;
+  total: number;
+  /** The login the run stopped at, and what to do about it. */
+  stop?: { login: string; reason: string };
+}
+
+/** One write's outcome. `read` decides "done": a 2xx with a body the next step cannot use is unknown. */
+type Outcome<T> = { kind: "done"; value: T } | { kind: "refused" } | { kind: "unknown" };
+
+async function attempt<T>(
+  write: () => Promise<unknown>,
+  read: (answer: any) => T | undefined,
+): Promise<Outcome<T>> {
+  let answer: unknown;
+  try {
+    answer = await write();
+  } catch (error) {
+    // Only a 4xx says the write did not apply. A 5xx, a network error or an unreadable body may follow a commit.
+    const refused =
+      error instanceof ErrorResponse && error.statusCode >= 400 && error.statusCode < 500;
+    return { kind: refused ? "refused" : "unknown" };
+  }
+  const value = read(answer);
+  return value === undefined ? { kind: "unknown" } : { kind: "done", value };
+}
+
+/** Kount: the writes of "One collection per item", in the admin console's own services (spike S3, S4, S7). */
+@Injectable()
+export class SplitCollectionsService {
+  private readonly collectionAdminService = inject(CollectionAdminService);
+  private readonly apiService = inject(ApiService);
+  private readonly accountService = inject(AccountService);
+
+  /** Splits in order and stops at the first login that cannot be split; never throws for a write's failure. */
+  async run(
+    organizationId: OrganizationId,
+    logins: CipherView[],
+    options: SplitOptions,
+    onDone: (done: number) => void,
+  ): Promise<SplitSummary> {
+    const userId = await firstValueFrom(this.accountService.activeAccount$.pipe(getUserId));
+    let done = 0;
+    for (const login of logins) {
+      const reason = await this.splitOne(organizationId, login, options, userId);
+      if (reason !== undefined) {
+        return { done, total: logins.length, stop: { login: login.name, reason } };
+      }
+      done += 1;
+      onDone(done);
+    }
+    return { done, total: logins.length };
+  }
+
+  /** Resolves undefined when the login is split, or the sentence that says why it is not. */
+  private async splitOne(
+    organizationId: OrganizationId,
+    login: CipherView,
+    options: SplitOptions,
+    userId: UserId,
+  ): Promise<string | undefined> {
+    const stamp = encodeStamp(loginFacts(login, options.includeUsername));
+    if (stamp === null) {
+      return "Its website and username are too long for an External ID, so nothing was written for it. Split it alone with “Include the username in the External ID” unticked.";
+    }
+    const name = collectionName(loginFacts(login), options.pattern, options.prefix);
+
+    const created = await this.create(organizationId, name, stamp, userId);
+    if (created.kind === "refused") {
+      return "The vault refused its new collection.";
+    }
+    if (created.kind === "unknown") {
+      return `The vault's answer to creating its collection “${name}” could not be read, so that collection may exist. Look for it before running this again: a second run makes a second one, and Kount Protect shows the two as a duplicate until one is deleted.`;
+    }
+
+    const assigned = await this.assign(login.id, created.value);
+    if (assigned.kind === "done") {
+      return undefined;
+    }
+    if (assigned.kind === "unknown") {
+      return `The vault's answer to moving it into its new collection “${name}” could not be read. That collection was kept: check the login's collections.`;
+    }
+    return (await this.remove(organizationId, created.value))
+      ? "The vault refused to move it, so its new collection was deleted."
+      : `The vault refused to move it, and its new collection “${name}” could not be deleted: it is empty, so delete it by hand.`;
+  }
+
+  private create(
+    organizationId: OrganizationId,
+    name: string,
+    stamp: string,
+    userId: UserId,
+  ): Promise<Outcome<CollectionId>> {
+    const view = new CollectionAdminView({
+      id: "" as CollectionId,
+      organizationId,
+      name,
+    });
+    view.externalId = stamp;
+    return attempt(
+      () => this.collectionAdminService.create(view, userId),
+      (response) => (Utils.isGuid(response?.id) ? (response.id as CollectionId) : undefined),
+    );
+  }
+
+  /** The login ends up in this collection alone: the write replaces its collections. */
+  private assign(cipherId: string, collectionId: CollectionId): Promise<Outcome<true>> {
+    return attempt(
+      () =>
+        this.apiService.send(
+          "PUT",
+          "/ciphers/" + cipherId + "/collections-admin",
+          { collectionIds: [collectionId] },
+          true,
+          true,
+        ),
+      (response) =>
+        Array.isArray(response?.collectionIds) &&
+        response.collectionIds.length === 1 &&
+        response.collectionIds[0] === collectionId
+          ? true
+          : undefined,
+    );
+  }
+
+  private async remove(organizationId: OrganizationId, collectionId: CollectionId): Promise<boolean> {
+    try {
+      await this.collectionAdminService.delete(organizationId, collectionId);
+      return true;
+    } catch {
+      return false;
+    }
+  }
+}
